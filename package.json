{
  "name": "foldline-document-workflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "test:gateway": "PYTHONPATH=services/ocr-gateway python3 services/ocr-gateway/test_security.py",
    "check": "npm run typecheck && npm run build && npm run test:gateway"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1102.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  }
}
