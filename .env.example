# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional analytics. Leave empty to disable Google Analytics entirely.
NEXT_PUBLIC_GA_ID=

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=...

# Cloudflare R2 server-only
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=foldline-private

# OCR gateway
OCR_GATEWAY_URL=https://ocr.example.com
OCR_GATEWAY_TOKEN=replace-with-32-plus-random-bytes
OCR_CALLBACK_SECRET=replace-with-another-32-plus-random-bytes

# Stripe (hosted Checkout; keys stay server-side)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
