# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional analytics. Leave empty to disable Google Analytics entirely.
NEXT_PUBLIC_GA_ID=

# Supabase server-only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=...

# Founder admin route. Set this to the exact Supabase Auth user UUID that is
# allowed to open /admin. If missing or different, /admin returns 404.
FOLDLINE_ADMIN_USER_ID=

# Cloudflare Workers AI is configured through the AI binding in wrangler.jsonc,
# not through a secret environment variable.
#
# R2 / external OCR gateway variables are no longer part of the active upload
# pipeline. Stripe billing is also intentionally disabled while Foldline uses
# pilot requests and preorder reservations.
